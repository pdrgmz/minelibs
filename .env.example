# -----------------------------------------------------------------------------
# Minelibs — variables de entorno (copiar a .env y ajustar)
# NUNCA hardcodear rutas, puertos ni secretos en el código.
# -----------------------------------------------------------------------------

# --- Servidor ---
NODE_ENV=production
PORT=3000
# Detrás de Nginx/Cloudflare: necesario para cookies Secure y X-Forwarded-*
TRUST_PROXY=true

# --- Base de datos (SQLite por defecto; Postgres opcional) ---
# SQLite: archivo en el volumen persistente
DATABASE_URL=file:/data/db/minelibs.db
# Postgres (opcional, cambiar el servicio en docker-compose):
# DATABASE_URL=postgresql://minelibs:minelibs@db:5432/minelibs

# --- Almacenamiento (volúmenes Docker) ---
STORAGE_DIR=/data/schematics
ASSETS_DIR=/data/assets
THUMBNAILS_DIR=/data/thumbnails

# --- Límites de subida y parseo ---
MAX_FILE_SIZE_MB=25
MAX_DECOMPRESSED_MB=256
MAX_DIMENSION=4096
MAX_BLOCKS=10000000

# --- Autenticación y usuarios ---
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto-antes-de-exponer-la-app
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar-esta-contrasena
REGISTRATION_ENABLED=true
MAX_SCHEMATICS_PER_USER=200
MAX_STORAGE_MB_PER_USER=1024
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MINUTES=1

# --- Visor 3D / assets de Minecraft ---
DEFAULT_MC_VERSION=1.21.4
ASSETS_UPSTREAM_URL=https://raw.githubusercontent.com/InventivetalentDev/minecraft-assets
ASSETS_CACHE_TTL_SECONDS=86400
ASSETS_FETCH_TIMEOUT_MS=10000
ASSETS_MAX_FILE_MB=16

# --- Export / import ZIP ---
MAX_IMPORT_ZIP_MB=512
MAX_IMPORT_ENTRIES=2000
MAX_MANIFEST_KB=2048
